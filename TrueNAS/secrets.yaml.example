---
# ============================================================================
# Reference copy of TrueNAS/secrets.yaml — plaintext, tracked, PLACEHOLDERS ONLY.
#
# TrueNAS's own secrets, and nothing else. Only the certificate's play reads
# them; site.yml and the update procedure need none.
#
#   mise run secrets:edit TrueNAS
#   mise run secrets:check
#
# .mise/sops-exec's `truenas` profile exports these as DNS_ZONE and
# CLOUDFLARE_DNS_API_TOKEN for one `mise run truenas:certificate` command;
# TrueNAS/ansible/inventory/group_vars/truenas.yml reads them back.
# ============================================================================

# The private zone: the certificate is for truenas.<zone>. The same value as
# dns/secrets.yaml's dns_zone. Not a secret, but kept here so the real domain
# stays out of the repo.
dns_zone: "example.com"

# Cloudflare API token for Let's Encrypt's DNS-01 challenge, this
# certificate's own (docs/CREDENTIALS.md § Cloudflare DNS tokens): Zone · DNS ·
# Edit on the zone above. TrueNAS stores it and uses it for every renewal.
cloudflare_dns_api_token: "CHANGE_ME"
