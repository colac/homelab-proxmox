# shellcheck shell=bash
# ============================================================================
# Repo root. Committed — no plaintext secrets live here.
#
# This decrypts secrets.yaml ONCE and exports every key in it as an
# environment variable. The per-tool .envrc files (packer/, terraform/,
# ansible/) inherit those via `source_up` and remap them into the naming each
# tool expects, so `cd`-ing into a directory is all it takes to have that
# tool's credentials present — and only that tool's.
#
# direnv runs this in the interactive shell, before any tool starts.
# ============================================================================

export SOPS_AGE_KEY_FILE="${HOME}/.config/sops/age/keys.txt"

# --- Sops editor config ------------------------------------------------------
export EDITOR="code --wait"

# --- Decrypt once at the root ------------------------------------------------
# Deliberately NOT `eval "$(... | sed 's/^/export /')"`: eval re-parses the
# decrypted text as shell, so any value containing a space, quote or $ would
# either break the export or be word-split. Reading line by line and calling
# `export` on the pair keeps values byte-exact, which matters for the JSON in
# nextcloud_users_json and for generated passwords.
if [ -f secrets.yaml ]; then
  if _sops_out="$(sops -d --output-type dotenv secrets.yaml 2>&1)"; then
    while IFS='=' read -r _sops_key _sops_value; do
      [ -n "${_sops_key}" ] || continue
      case "${_sops_key}" in \#*) continue ;; esac
      export "${_sops_key}=${_sops_value}"
    done <<<"${_sops_out}"
  else
    log_error "sops could not decrypt secrets.yaml — is ${SOPS_AGE_KEY_FILE} present? ${_sops_out}"
  fi
  unset _sops_out _sops_key _sops_value
else
  log_status "no secrets.yaml yet — create it with 'sops secrets.yaml' (see secrets.yaml.example)"
fi

# --- Non-secret, shared by all three tools -----------------------------------
# The endpoint itself comes from secrets.yaml: the hypervisor's address is not
# a credential, but it is not something to publish on GitHub either.
export PROXMOX_ENDPOINT="${proxmox_endpoint:-}"
export PROXMOX_NODE="pve"
# Set to "true" if the Proxmox web endpoint serves a self-signed certificate.
# Both Packer and Terraform read this.
export PROXMOX_TLS_INSECURE="false"

# --- Convenience -------------------------------------------------------------
# Ansible is installed only into the repo venv (make install-python-tools).
# Putting it on PATH here removes the "source .venv/bin/activate first" step.
PATH_add "${PWD}/.venv/bin"

# Per-machine overrides (git-ignored), e.g. a different PROXMOX_TLS_INSECURE
# or a PROXMOX_NODE on a second host. Sourced last so it wins.
source_env_if_exists .envrc.local

watch_file secrets.yaml
watch_file .sops.yaml
