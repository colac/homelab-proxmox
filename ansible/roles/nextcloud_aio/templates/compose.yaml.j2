# Managed by Ansible (role: nextcloud_aio) — do not edit by hand.
# Nextcloud All-in-One in reverse-proxy mode, fronted by the Caddy reverse proxy
# (role: reverse_proxy), which terminates TLS for the public domain.
# Reference: https://github.com/nextcloud/all-in-one/blob/main/reverse-proxy.md
services:
  nextcloud-aio-mastercontainer:
    image: {{ nextcloud_aio_image }}
    init: true
    restart: always
    container_name: nextcloud-aio-mastercontainer
    volumes:
      - nextcloud_aio_mastercontainer:/mnt/docker-aio-config
      - /var/run/docker.sock:/var/run/docker.sock:ro
    ports:
      # Admin UI bound to localhost only — reach via SSH tunnel or Tailscale.
      - "127.0.0.1:{{ nextcloud_aio_admin_port }}:8080"
    environment:
      APACHE_PORT: {{ nextcloud_aio_apache_port }}
      APACHE_IP_BINDING: {{ nextcloud_aio_apache_ip_binding }}
      SKIP_DOMAIN_VALIDATION: "{{ nextcloud_aio_skip_domain_validation | bool | lower }}"
{% for key, value in nextcloud_aio_extra_env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}

volumes:
  nextcloud_aio_mastercontainer:
    name: nextcloud_aio_mastercontainer
