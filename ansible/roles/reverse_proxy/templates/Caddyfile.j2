# Managed by Ansible (role: reverse_proxy) — do not edit by hand.
{
{% if reverse_proxy_acme_email | length > 0 %}
	email {{ reverse_proxy_acme_email }}
{% endif %}
}

{{ nextcloud_domain }} {
	reverse_proxy {{ reverse_proxy_upstream_host }}:{{ reverse_proxy_upstream_port }}
	tls {
		dns cloudflare {env.cloudflare_dns_api_token}
	}
}
