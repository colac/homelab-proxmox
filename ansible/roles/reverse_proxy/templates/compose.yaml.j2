# Managed by Ansible (role: reverse_proxy) — do not edit by hand.
# Caddy terminates TLS for {{ nextcloud_domain }} and proxies to AIO's Apache.
# network_mode: host lets Caddy reach the localhost-bound AIO upstream
# (127.0.0.1:{{ reverse_proxy_upstream_port }}) and bind :80/:443 directly.
services:
  caddy:
    build: .
    image: nextcloud-caddy:local
    container_name: nextcloud-caddy
    init: true
    restart: always
    network_mode: host
    env_file:
      - .env
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config

volumes:
  caddy_data:
    name: nextcloud_caddy_data
  caddy_config:
    name: nextcloud_caddy_config
