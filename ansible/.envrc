# shellcheck shell=bash
# Ansible has no TF_VAR_/PKR_VAR_ convention of its own, so the variables below
# are read explicitly with `lookup('env', ...)` from inventory/group_vars/.
# Names are UPPER_SNAKE here purely to mark them as coming from the
# environment; the group_vars files are the only place they are consumed.
source_up

# Lets ansible-playbook find this config from any subdirectory.
export ANSIBLE_CONFIG="${PWD}/ansible.cfg"

# --- Nextcloud ---------------------------------------------------------------
export NEXTCLOUD_DOMAIN="${nextcloud_domain:-}"
export REVERSE_PROXY_ACME_EMAIL="${reverse_proxy_acme_email:-}"
export NEXTCLOUD_NAS_USER="${nextcloud_nas_user:-}"
export NEXTCLOUD_NAS_PASSWORD="${nextcloud_nas_password:-}"
# Single-line JSON array; group_vars/nextcloud.yml parses it with from_json.
export NEXTCLOUD_USERS_JSON="${nextcloud_users_json:-[]}"
export CLOUDFLARE_DNS_API_TOKEN="${cloudflare_dns_api_token:-}"
export TAILSCALE_AUTHKEY="${tailscale_authkey:-}"

# --- Monitoring (Elastic Stack) ----------------------------------------------
export ELASTIC_PASSWORD="${elastic_password:-}"
export KIBANA_SYSTEM_PASSWORD="${kibana_system_password:-}"
export KIBANA_ENCRYPTION_KEY="${kibana_encryption_key:-}"
export NEXTCLOUD_SERVERINFO_TOKEN="${nextcloud_serverinfo_token:-}"
export PVE_EXPORTER_TOKEN_ID="${pve_exporter_token_id:-}"
export PVE_EXPORTER_TOKEN_SECRET="${pve_exporter_token_secret:-}"

# --- Sops editor config ------------------------------------------------------
export EDITOR="code --wait"
