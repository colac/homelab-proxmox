---
# ============================================================================
# Reference copy of secrets.yaml — plaintext, tracked, PLACEHOLDERS ONLY.
#
# The real file is secrets.yaml: same keys, real values, SOPS-encrypted with
# age so it is ciphertext on disk and committed alongside the code. This
# example exists because a reader without the age key cannot see the key names
# inside the encrypted file.
#
#   mise run secrets:edit      # decrypt -> VS Code -> re-encrypt on save
#   mise run secrets:check     # which keys are missing (never prints values)
#
# Nothing reads this file directly. .mise/sops-exec decrypts it for one
# command at a time and hands that command only what it needs, renamed to what
# the tool reads (PKR_VAR_*). See docs/CREDENTIALS.md.
#
# Core's infrastructure credentials: building templates (Packer) and its
# platform services' Terraform (dns/terraform). Pi-hole's own secrets are in
# dns/secrets.yaml; the app repos keep theirs.
# Keep this file's KEYS in sync with secrets.yaml; never put a real value here.
# ============================================================================

# Base API endpoint, no /api2/json suffix — sops-exec appends it. Kept here
# rather than in mise.toml so the hypervisor's address stays out of the repo.
proxmox_endpoint: "https://pve.example.com:8006"

# packer@pve!packer-automation — template-build rights only. The Terraform
# token (clone/configure rights) lives in the repos that run Terraform. See
# packer/README.md for the pveum commands.
proxmox_packer_token_id: "packer@pve!packer-automation"
proxmox_packer_token_secret: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Console login hash for the default user (SSH is key-only; this is the
# tty/serial fallback). Generate with `mkpasswd -m sha-512 'your-password'`
# from the `whois` package.
packer_password_hash: "$6$rounds=4096$REPLACE_ME_WITH_A_REAL_SHA512_HASH"

# Core's own Terraform token (clone/configure rights) — a separate user from
# the other repos', so revoking one cannot break another. Used by
# `mise run dns:*`. See docs/CREDENTIALS.md.
proxmox_terraform_token_id: "terraform-core@pve!terraform-automation-core"
proxmox_terraform_token_secret: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# app.terraform.io API token. Empty = use `terraform login` credentials.
tf_cloud_token: ""
