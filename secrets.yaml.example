---
# ============================================================================
# Reference copy of secrets.yaml — plaintext, tracked, PLACEHOLDERS ONLY.
#
# The real file is secrets.yaml: same keys, real values, SOPS-encrypted with
# age so it is ciphertext on disk and committed alongside the code. This
# example exists because a reader without the age key cannot see the key names
# inside the encrypted file.
#
#   sops secrets.yaml          # decrypt -> $EDITOR -> re-encrypt on save
#   sops -d secrets.yaml       # print decrypted (read-only)
#
# Every key below is exported as an environment variable by the .envrc files
# (root, packer/, terraform/, ansible/) when direnv loads. Nothing here is ever
# read directly by Packer, Terraform or Ansible — they only see env vars.
#
# Keep this file's KEYS in sync with secrets.yaml; never put a real value here.
# ============================================================================

# ----------------------------------------------------------------------------
# Proxmox — three values plus two API tokens
#
# Two separate tokens on purpose: Packer needs template-build rights, Terraform
# needs clone/configure rights, and neither should carry the other's. See
# packer/README.md and terraform/README.md for the exact pveum commands.
# ----------------------------------------------------------------------------
# Base API endpoint, no /api2/json suffix — the .envrc files append it.
# Kept here rather than in .envrc so the hypervisor's address stays out of the
# public repo.
proxmox_endpoint: "https://pve.example.com:8006"

# packer@pve!packer-automation
proxmox_packer_token_id: "packer@pve!packer-automation"
proxmox_packer_token_secret: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# terraform@pve!terraform-automation
proxmox_terraform_token_id: "terraform@pve!terraform-automation"
proxmox_terraform_token_secret: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ----------------------------------------------------------------------------
# Packer — template build
# ----------------------------------------------------------------------------
# Console login hash for the default user (SSH is key-only; this is the
# tty/serial fallback). Generate with `mkpasswd -m sha-512 'your-password'`
# from the `whois` package.
packer_password_hash: "$6$rounds=4096$REPLACE_ME_WITH_A_REAL_SHA512_HASH"

# ----------------------------------------------------------------------------
# Terraform Cloud
# ----------------------------------------------------------------------------
# API token for app.terraform.io (org colac_homelab). Workspaces run in Local
# execution mode, but state still lives in TFC, so `terraform init` needs this.
# Leave empty to fall back to `terraform login` credentials in
# ~/.terraform.d/credentials.tfrc.json.
tf_cloud_token: ""

# ----------------------------------------------------------------------------
# Nextcloud
# ----------------------------------------------------------------------------
# Public hostname. Not a secret, but kept here so the real domain stays out of
# the tracked repo. MUST match the domain submitted in AIO's first-run UI.
nextcloud_domain: "nextcloud.example.com"

# Let's Encrypt account email (expiry notices). Empty = anonymous registration.
reverse_proxy_acme_email: "you@example.com"

# TrueNAS SMB account with read/write on the media share.
nextcloud_nas_user: "CHANGE_ME"
nextcloud_nas_password: "CHANGE_ME"

# Nextcloud accounts to create beyond the AIO admin, as a single-line JSON
# array. JSON rather than nested YAML because `sops -d --output-type dotenv`
# only emits flat key=value pairs; ansible parses it back with `| from_json`.
#   name          login name (required, lowercase)
#   password      required
#   display_name  optional, defaults to name
#   nas_folder    optional; true attaches <personal share>/<name> as a private
#                 read-write mount visible only to that account. The subfolder
#                 must already exist on the NAS.
# Usernames live here with the passwords so no family name is in the repo.
nextcloud_users_json: '[{"name":"alice","display_name":"Alice","password":"CHANGE_ME","nas_folder":true}]'

# Cloudflare API token for ACME DNS-01, scoped Zone:DNS:Edit on your zone.
# Used by Caddy to obtain the TLS certificate.
cloudflare_dns_api_token: "CHANGE_ME"

# Tailscale auth key, to join the tailnet non-interactively. Leave empty to
# skip `tailscale up` and authenticate by hand later.
tailscale_authkey: ""

# ----------------------------------------------------------------------------
# Monitoring — single-node Elasticsearch + Kibana + Fleet
#
# Only human-chosen secrets belong here. Everything the stack generates itself
# (the internal CA, the node certificate, Fleet service and enrollment tokens)
# is cached under ansible/.certs/ and ansible/.secrets-cache/, both git-ignored.
# Generated material is machine state, recoverable by re-running the roles
# against an empty cluster — round-tripping it through here would add risk
# without adding control.
# ----------------------------------------------------------------------------
# The `elastic` superuser. Bootstraps everything else and logs in to Kibana.
elastic_password: "CHANGE_ME"

# The built-in kibana_system user. Kibana authenticates to Elasticsearch as
# this least-privilege account, never as `elastic`.
kibana_system_password: "CHANGE_ME"

# Fleet encrypts the service tokens and API keys it stores as Kibana saved
# objects with this. POST /api/fleet/setup fails outright without it.
#   openssl rand -hex 32
kibana_encryption_key: "CHANGE_ME"

# Nextcloud serverinfo API token for the application-metrics exporter. A
# dedicated token rather than an admin account, so the monitoring VM holds no
# credential that can log in. Generate on the Nextcloud VM:
#   docker exec -u www-data nextcloud-aio-nextcloud \
#     php occ config:app:set serverinfo token --value "$(openssl rand -hex 32)"
nextcloud_serverinfo_token: "CHANGE_ME"

# Proxmox host metrics. Only needed once exporters_pve_enabled is true in
# ansible/inventory/group_vars/monitoring.yml. Read-only PVEAuditor token —
# see MONITORING.md for the pveum commands.
pve_exporter_token_id: "pve-exporter@pve!monitoring"
pve_exporter_token_secret: "CHANGE_ME"
