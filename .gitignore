# Packer
packer-manifest.json
packer_cache/
# https://www.packer.io/guides/hcl/variables
# Exclude all .pkrvars.hcl files, which are likely to contain sensitive data,
# such as password, private keys, and other secrets. These should not be part of
# version control as they are data points which are potentially sensitive and
# subject to change depending on the environment.
#
*.pkrvars.hcl
*.auto.pkvars.hcl
crash.log
*.box

# Secrets and credentials
secrets/
*.secret
*.key
*.pem
*.p12
*.pfx

# Ansible — the collection is linted here, never run, so there is no
# inventory or generated material in this repo any more.
*.retry
.ansible/
ansible.log
*.tar.gz
# dns/ — generated by its Terraform: the container's address is machine state.
dns/ansible/inventory/pihole.yml
# dns/ — hand-authored resolvers outside Terraform (the Raspberry Pi): addresses.
dns/ansible/inventory/hosts.yml
# Legacy: secrets moved to the SOPS-encrypted secrets.yaml at the repo root.
# Kept ignored so an old local vault.yml can never be committed by accident.
ansible/vault.yml

