# ============================================================================
# Example Packer variables for the Ubuntu 24.04 template build.
# Copy to variables.pkrvars.hcl and fill in your values (that file is
# git-ignored via *.pkrvars.hcl because it contains secrets).
#
#   packer init .
#   packer validate -var-file=variables.pkrvars.hcl .
#   packer build    -var-file=variables.pkrvars.hcl .
# ============================================================================

# --- Proxmox connection -----------------------------------------------------
proxmox_api_url          = "https://pve.example.com:8006/api2/json"
proxmox_api_token_id     = "packer@pve!packer-automation"
proxmox_api_token_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_node             = "pve"
proxmox_skip_tls_verify  = false # valid Let's Encrypt (ACME) cert on pve.example.com

# --- Source ISO (must already exist in Proxmox storage) ---------------------
boot_iso_file = "local:iso/ubuntu-24.04.3-live-server-amd64.iso"

# --- Template identity ------------------------------------------------------
vm_id   = 9000
vm_name = "ubuntu-24.04-template"

# --- Default user -----------------------------------------------------------
username = "ubuntu"

# Plaintext password is unused by default (console login uses password_hash);
# leave empty unless you re-enable the commented ssh_password in the template.
password = ""

# Console login hash for the default user. Generate with:
#   mkpasswd -m sha-512 'your-password'      (from the 'whois' package)
password_hash = "$6$rounds=4096$REPLACE_ME_WITH_A_REAL_SHA512_HASH"

# --- SSH --------------------------------------------------------------------
# Dedicated deploy key generated by NEXTCLOUD.md (~/.ssh/homelab-proxmox).
# Packer uses the private key to connect to the VM during the build.
ssh_private_key_file = "~/.ssh/homelab-proxmox"

# REQUIRED IN PRACTICE: password auth is disabled in the image, so the matching
# PUBLIC key MUST be listed here or neither Packer nor you can ever log in.
# This is the contents of ~/.ssh/homelab-proxmox.pub.
ssh_authorized_keys = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAID4ZFYyuTpYeRoSIOqsIfWxjt9Wyplz2ZuB3iT8bBX3a homelab-proxmox-nextcloud-deploy"
]

# Building locally while a VPN holds the default route? Pin the HTTP server to
# your LAN NIC so the VM can reach it (find yours with `ip -br addr`). Leave
# empty to auto-detect.
http_interface = "wlp0s20f3"

# --- Optional overrides (sensible defaults already set in variables.pkr.hcl)-
# storage_pool      = "local-lvm"
# network_bridge    = "vmbr0"
# disk_size         = "60G"
# vm_cpu_cores      = 2
# vm_memory         = 2048
# install_docker    = true
# install_tailscale = true
# enable_proxy      = false
