# shellcheck shell=bash
# Packer reads PKR_VAR_<name> for any variable declared in variables.pkr.hcl,
# so nothing below needs a *.pkrvars.hcl file. A -var-file passed on the
# command line still wins over these, which is what keeps an existing local
# variables.pkrvars.hcl working unchanged.
source_up

export PKR_VAR_proxmox_api_url="${PROXMOX_ENDPOINT}/api2/json"
export PKR_VAR_proxmox_api_token_id="${proxmox_packer_token_id:-}"
export PKR_VAR_proxmox_api_token_secret="${proxmox_packer_token_secret:-}"
export PKR_VAR_proxmox_node="${PROXMOX_NODE}"
export PKR_VAR_proxmox_skip_tls_verify="${PROXMOX_TLS_INSECURE}"

# Building while a VPN holds the default route? Set PACKER_HTTP_INTERFACE to
# the LAN NIC (see `ip -br addr`) in .envrc.local so {{ .HTTPIP }} in the boot
# command resolves to an address the VM can actually reach. Empty = auto-detect.
export PKR_VAR_http_interface="${PACKER_HTTP_INTERFACE:-}"

# Console-login hash for the default user (SSH is key-only).
export PKR_VAR_password_hash="${packer_password_hash:-}"

# The deploy key's PUBLIC half, injected as a one-element HCL list. Read from
# disk rather than stored anywhere in the repo: password auth is disabled in
# the image, so if this is empty nobody — including Packer — can ever log in
# to the built template.
if [ -f "${HOME}/.ssh/homelab-proxmox.pub" ]; then
  _pkr_pubkey="$(cat "${HOME}/.ssh/homelab-proxmox.pub")"
  export PKR_VAR_ssh_authorized_keys="[\"${_pkr_pubkey}\"]"
  unset _pkr_pubkey
else
  log_error "${HOME}/.ssh/homelab-proxmox.pub not found — the template would be built with no way to log in"
fi

watch_file "${HOME}/.ssh/homelab-proxmox.pub"
