# shellcheck shell=bash
# Terraform reads TF_VAR_<name> for any declared variable, at any depth — this
# one .envrc therefore covers every project under projects/, since direnv walks
# up from the working directory to find it. No project needs a terraform.tfvars
# holding credentials; a local one still wins if present.
source_up

# Terraform Cloud holds the state (workspaces run in Local execution mode, so
# the apply itself happens here against Proxmox). Empty falls back to whatever
# `terraform login` wrote to ~/.terraform.d/credentials.tfrc.json.
if [ -n "${tf_cloud_token:-}" ]; then
  export TF_TOKEN_app_terraform_io="${tf_cloud_token}"
fi

export TF_VAR_pm_api_url="${PROXMOX_ENDPOINT}/api2/json"
export TF_VAR_pm_api_token_id="${proxmox_terraform_token_id:-}"
export TF_VAR_pm_api_token_secret="${proxmox_terraform_token_secret:-}"
export TF_VAR_pm_tls_insecure="${PROXMOX_TLS_INSECURE}"
