# ----------------------------------------------------------------------------
# OPTIONAL overrides for the k3s project. Copy to terraform.tfvars only if
# you need to change something — every variable below already has a default in
# variables.tf, so `terraform apply` works with no tfvars file at all.
#
# The Proxmox endpoint and API token are deliberately NOT here. They arrive as
# TF_VAR_pm_api_url / TF_VAR_pm_api_token_id / TF_VAR_pm_api_token_secret from
# terraform/.envrc, which direnv fills by decrypting the repo-root secrets.yaml
# (SOPS + age). That keeps every credential out of the working tree, which is
# why *.tfvars is git-ignored and this .example carries no secrets.
# ----------------------------------------------------------------------------

# Where to place the VM
proxmox_node    = "pve"
proxmox_pool    = null
proxmox_storage = "local-lvm"
network_bridge  = "vmbr0"

# Template produced by the Packer build
template_name = "ubuntu-26.04-template"

# k3s VM sizing
vm_name        = "k3s"
cpu_cores      = 2
memory_mb      = 8192
disk0_size     = "24G"
data_disk_size = "12G"

# Cloud-init user + SSH key used by Terraform and, later, Ansible
vm_user        = "ubuntu"
ssh_public_key = "~/.ssh/id_rsa.pub"
