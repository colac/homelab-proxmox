# ----------------------------------------------------------------------------
# Example tfvars for the Nextcloud VM project.
# Copy to terraform.tfvars and fill in the secrets (terraform.tfvars is
# git-ignored via *.tfvars).
# ----------------------------------------------------------------------------

# Proxmox API connection
pm_api_url          = "https://pve.example.com:8006/api2/json"
pm_api_token_id     = "terraform@pve!terraform-automation"
pm_api_token_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Where to place the VM
proxmox_node    = "pve"
proxmox_pool    = null
proxmox_storage = "local-lvm"
network_bridge  = "vmbr0"

# Template produced by the Packer build
template_name = "ubuntu-24.04-template"

# Nextcloud VM sizing (AIO + Postgres + Redis comfortably fit here)
vm_name    = "nextcloud"
cpu_cores  = 4
memory_mb  = 8192
disk0_size = "64G"

# Cloud-init user + SSH key used by Terraform and, later, Ansible.
# Dedicated deploy key generated by NEXTCLOUD.md.
vm_user        = "ubuntu"
ssh_public_key = "~/.ssh/homelab-proxmox.pub"
