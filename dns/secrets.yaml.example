---
# ============================================================================
# Reference copy of dns/secrets.yaml — plaintext, tracked, PLACEHOLDERS ONLY.
#
# Pi-hole's own secrets, and nothing else; the Proxmox and Terraform Cloud
# tokens are in the repo-root secrets.yaml.
#
#   mise run secrets:edit dns
#   mise run secrets:check
#
# .mise/sops-exec's `dns` profile exports these as DNS_ZONE and
# PIHOLE_WEB_PASSWORD for one `mise run dns:play …` command;
# dns/ansible/inventory/group_vars/pihole.yml reads them back.
# ============================================================================

# The private zone the A records live in (pve.<zone>, nextcloud.<zone>, …).
# Not a secret, but kept here so the real domain stays out of the repo.
dns_zone: "example.com"

# Pi-hole web UI / API password. Set declaratively (FTLCONF), so changing it
# here and re-running the playbook is the only way to change it.
#   openssl rand -base64 24
pihole_web_password: "CHANGE_ME"
