---
# ============================================================================
# Reference copy of dns/secrets.yaml — plaintext, tracked, PLACEHOLDERS ONLY.
#
# The secrets of dns/'s two deployments, Pi-hole and the Pi's notification
# services; the Proxmox and Terraform Cloud tokens are in the repo-root
# secrets.yaml.
#
#   mise run secrets:edit dns
#   mise run secrets:generate     # the ntfy keys below: never typed
#   mise run secrets:check
#
# .mise/sops-exec gives each deployment only its own keys: profile `dns`
# (DNS_ZONE, PIHOLE_WEB_PASSWORD) for `mise run dns:play …`, read back by
# dns/ansible/inventory/group_vars/pihole.yml; profile `ntfy` (NTFY_*) for
# `mise run dns:play:ntfy …`, read back by group_vars/ntfy.yml.
# ============================================================================

# The private zone the A records live in (pve.<zone>, nextcloud.<zone>, …).
# Not a secret, but kept here so the real domain stays out of the repo.
dns_zone: "example.com"

# Pi-hole web UI / API password. Set declaratively (FTLCONF), so changing it
# here and re-running the playbook is the only way to change it.
#   openssl rand -base64 24
pihole_web_password: "CHANGE_ME"

# ---------------------------------------------------------------------------
# The Pi's notification services (dns/NTFY.md). Generated, never typed:
# `mise run secrets:generate` creates the missing ones (a CHANGE_ME counts
# as missing) and replaces one you name (rotation, NTFY.md).
# ---------------------------------------------------------------------------

# The phone's login on the private ntfy (user `phone`): 32 letters and
# digits. The Pi keeps only its bcrypt hash.
ntfy_phone_password: "CHANGE_ME"

# The doorbell's topic on ntfy.sh, its only protection: anyone who knows it
# can ring. 32 letters and digits.
ntfy_doorbell_topic: "CHANGE_ME"

# One ntfy token per client that is not the phone ("tk_" and 29 lowercase
# letters or digits). group_vars/ntfy.yml says what each may do.
ntfy_actions_token: "CHANGE_ME"   # sent by the phone's buttons
ntfy_notifier_token: "CHANGE_ME"  # monitoring's alert notifier, on the Pi
ntfy_runner_token: "CHANGE_ME"    # monitoring's investigation runner, laptop
ntfy_doorbell_token: "CHANGE_ME"  # the doorbell, on the Pi
