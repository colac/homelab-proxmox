{#- systemd EnvironmentFile: values are double-quoted with \ and " escaped, so
    a password with spaces, quotes, # or $ arrives intact. Arrays are joined
    with ";" — Pi-hole's separator for FTLCONF_ array values. -#}
{%- macro q(value) -%}
"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') }}"
{%- endmacro -%}
# Managed by Ansible (role: pihole) — do not edit. Every FTLCONF_ variable here
# makes the matching setting read-only in Pi-hole's web UI; change it in
# homelab-proxmox/dns/ansible/inventory/group_vars/pihole.yml instead.
FTLCONF_dns_upstreams={{ q(pihole_upstreams | join(';')) }}
FTLCONF_dns_hosts={{ q(pihole_ftl_hosts | join(';')) }}
FTLCONF_dns_cnameRecords={{ q(pihole_ftl_cnames | join(';')) }}
FTLCONF_dns_listeningMode={{ q(pihole_listening_mode) }}
FTLCONF_webserver_api_password={{ q(pihole_web_password) }}
{% for key, value in pihole_ftlconf_extra.items() %}
FTLCONF_{{ key }}={{ q(value) }}
{% endfor %}
